{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Photon",
  "colors": {
    "primary": "#47c6ed",
    "light": "#47c6ed",
    "dark": "#47c6ed"
  },
  "fonts": {
    "heading": {
      "family": "PolySansArabicVF",
      "source": "/fonts/PolySansArabicVF.woff2",
      "format": "woff2"
    },
    "body": {
      "family": "PolySansArabicVF",
      "source": "/fonts/PolySansArabicVF.woff2",
      "format": "woff2"
    }
  },
  "favicon": "/favicon-128x128.png",
  "navigation": {
