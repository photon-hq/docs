              {
                "group": "Get started",
                "pages": [
                  "index"
                ]
              }
            ],
            "global": {
              "anchors": [
                {
                  "anchor": "Blog",
                  "href": "https://photon.codes/blog",
                  "icon": "newspaper"
                }
              ]
            }
          },
          {
            "tab": "Messaging",
            "groups": [
              {
                "group": "Get started",
                "pages": [
                  "messaging/index"
                ]
              }
            ]
          },
          {
            "tab": "Cookbooks",
            "groups": [
              {
                "group": "Get started",
                "pages": [
                  "cookbooks/index"
                ]
              },
              {
                "group": "Voice",
                "pages": [
                  "cookbooks/voice/retell",
                  "cookbooks/voice/elevenlabs",
                  "cookbooks/voice/livekit"
                ]
              }
            ]
          },
          {
            "tab": "CLI",
            "groups": [
              {
                "$source": "photon-cli",
                "group": "Get started"
              },
              {
                "$source": "photon-cli",
                "group": "Projects"
              },
              {
                "$source": "photon-cli",
                "group": "Account"
              },
              {
                "$source": "photon-cli",
                "group": "Compliance"
              },
              {
                "$source": "photon-cli",
                "group": "Reference"
              }
            ]
          },
          {
            "tab": "API Reference",
            "groups": [
              {
                "group": "Get started",
                "pages": [
                  "api-reference/index"
                ]
              },
              {
                "group": "Problems",
                "pages": [
                  "problems/handling-errors",
                  "problems/catalog"
                ]
              },
              {
                "group": "Endpoints",
                "openapi": {
                  "source": "https://api.staging.photon.codes/openapi.json",
                  "directory": "api-reference"
                }
              },
              {
                "group": "WebSocket",
                "pages": [
                  {
                    "$source": "fusor-ws",
                    "group": "WebSocket protocol"
                  },
                  {
                    "$source": "fusor-ws",
                    "group": "Frame reference"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "$source": "maintain",
        "version": "Maintain"
      }
    ]
