{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Photon",
  "colors": {
    "primary": "#47c6ed",
    "light": "#47c6ed",
    "dark": "#47c6ed"
  },
  "fonts": {
