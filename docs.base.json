    "body": {
      "family": "PolySansArabicVF",
      "source": "/fonts/PolySansArabicVF.woff2",
      "format": "woff2"
    }
  },
  "favicon": "/favicon-128x128.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Spectrum",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index"
            ]
          }
        ]
      },
      {
        "tab": "CLI",
        "groups": [
          {
            "$source": "photon-cli",
            "group": "Get started"
          },
          {
            "$source": "photon-cli",
            "group": "Projects"
          },
          {
            "$source": "photon-cli",
            "group": "Account"
          },
          {
            "$source": "photon-cli",
            "group": "Compliance"
          },
          {
            "$source": "photon-cli",
            "group": "Reference"
          }
        ]
      },
      {
        "tab": "Webhooks",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "webhooks/index"
            ]
          }
        ]
      },
      {
        "tab": "Low-level SDKs",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "low-level-sdks/index"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "api-reference/index"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": {
              "source": "https://api.staging.photon.codes/openapi.json",
              "directory": "api-reference"
            }
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Blog",
          "href": "https://photon.codes/blog",
          "icon": "newspaper"
        }
      ]
