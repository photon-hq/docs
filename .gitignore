.DS_Store
.mintlify/
node_modules/

# Build tooling
.pnpm-store
.typecheck-output

# Aggregated template tree, assembled by scripts/sync-docs from docs-src/ + source repos
.vellum-src/

# Navigation, generated by scripts/build-nav from docs.base.json + source nav fragments
/docs.json

# Custom llms.txt generator output (built from docs.json + rendered .mdx)
llms.txt
llms-full.txt
llms-*.txt

# Rendered from photon-hq/cli-beta (source "photon-cli", mount "cli") by
# `vellum build`. The whole directory is generated -- see scripts/sources.json.
/cli/

# Rendered from photon-hq/fusor-v2; the contract is copied verbatim by docs:sync.
/websocket/
/asyncapi/fusor-v2.yaml

# Problem catalogue, generated by scripts/build-problems from the OpenAPI spec.
# Its header lives in scripts/build-problems/catalog-header.mdx. The Handling
# errors page beside it is hand-owned, and a re-include cannot escape an
# excluded directory -- so exclude the contents, not the directory.
/problems/*
!/problems/handling-errors.mdx

# Combined staging site; its contents become the root of dist.
/site/
